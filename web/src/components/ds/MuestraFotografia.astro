---
import Portada from '../Portada.astro';
---
<div class="ds-fotos">
  <figure class="ds-foto-compo"><Portada /><figcaption>Composición de referencia: videollamada sobre la mancha de corazón</figcaption></figure>
  <figure class="ds-foto-cierre">
    <img src="/decks/investor-deck/img-presentacion/cierre-sesion.jpg" alt="Paciente en su casa cerrando la laptop al terminar la sesión, con el tratamiento de color de la marca" loading="lazy" />
    <figcaption>Escena de cierre · después de la sesión</figcaption>
  </figure>
</div>
<div class="ds-fotos-sueltas">
  <figure><img src="/img/portada-terapeuta.jpg" alt="Psicóloga en su consultorio, con el tratamiento de color de la marca" loading="lazy" /><figcaption>Profesional · tratamiento aplicado</figcaption></figure>
  <figure><img src="/img/portada-paciente.jpg" alt="Paciente en su casa, con el tratamiento de color de la marca" loading="lazy" /><figcaption>Paciente · tratamiento aplicado</figcaption></figure>
  <figure class="vertical"><img src="/decks/investor-deck/img-presentacion/estado-landing.jpg" alt="Paciente en el sillón con una taza y la sesión abierta en la laptop, con el tratamiento de color de la marca" loading="lazy" /><figcaption>Escena en casa · sesión en la laptop</figcaption></figure>
</div>
