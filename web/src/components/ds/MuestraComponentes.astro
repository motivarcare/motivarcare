---
import Estado from '../Estado.astro';
---
<div class="ds-comp">
  <div class="ds-comp-grupo">
    <p class="ds-comp-titulo">Etiqueta de sección</p>
    <span class="ds-tag">Plan de inversión</span>
  </div>
  <div class="ds-comp-grupo">
    <p class="ds-comp-titulo">Botones</p>
    <div class="ds-fila">
      <span class="ds-btn amarillo">Reservar sesión</span>
      <span class="ds-btn bosque">Continuar</span>
      <span class="ds-btn contorno">Ver detalle</span>
    </div>
  </div>
  <div class="ds-comp-grupo">
    <p class="ds-comp-titulo">Chips de estado</p>
    <div class="ds-fila">
      <Estado estado="sin-iniciar" /><Estado estado="en-curso" /><Estado estado="en-revision" /><Estado estado="completado" />
    </div>
  </div>
  <div class="ds-comp-grupo">
    <p class="ds-comp-titulo">Tarjetas</p>
    <div class="ds-tarjetas">
      <div class="ds-tarjeta blanca"><span class="ds-numeral">01</span><b>Blanca</b><p>Contenido general.</p></div>
      <div class="ds-tarjeta menta"><span class="ds-numeral">02</span><b>Menta</b><p>Información de apoyo.</p></div>
      <div class="ds-tarjeta salvia"><span class="ds-numeral">03</span><b>Salvia</b><p>Lo destacado.</p></div>
      <div class="ds-tarjeta lima"><span class="ds-numeral">04</span><b>Lima</b><p>Contraste suave.</p></div>
      <div class="ds-tarjeta bosque"><span class="ds-numeral">05</span><b>Bosque</b><p>Mensaje principal.</p></div>
      <div class="ds-tarjeta punteada"><span class="ds-numeral">06</span><b>Punteada</b><p>Provisorio o por definir.</p></div>
    </div>
  </div>
  <div class="ds-comp-grupo">
    <p class="ds-comp-titulo">Listas de estado y nota</p>
    <ul class="ds-ticks">
      <li class="ok">Web pública y acceso a portales</li>
      <li class="ok">Matching con profesionales</li>
      <li class="pend">Tablero de métricas</li>
    </ul>
    <p class="ds-nota"><span class="i">i</span>Las notas usan texto chico en tinta suave, con un círculo amarillo suave al inicio.</p>
  </div>
  <div class="ds-comp-grupo">
    <p class="ds-comp-titulo">Controles de videollamada</p>
    <div class="ds-controles">
      <span><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg></span>
      <span><svg viewBox="0 0 24 24"><rect x="3" y="6" width="13" height="12" rx="3" /><path d="M16 10l5-3v10l-5-3" /></svg></span>
      <span><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z" /></svg></span>
      <span class="fin"><svg viewBox="0 0 24 24"><path d="M3 14.5c5-4.5 13-4.5 18 0l-2.2 2.4-3.3-1.6v-2.6c-2.3-.8-4.7-.8-7 0v2.6l-3.3 1.6z" /></svg></span>
    </div>
  </div>
</div>
