---
/* Íconos de línea calados en crema sobre manchas que se deforman lento. */
const manchas = [
  { color: '#F5C33B', opac: 0.85, nombre: 'Referidos', icono: '<path d="M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z"/>' },
  { color: '#9FC9AE', opac: 0.9, nombre: 'Contenido', icono: '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M5.5 18.5l1.7-1.7M16.8 7.2l1.7-1.7"/>' },
  { color: '#2F6B51', opac: 0.85, nombre: 'Campañas', icono: '<path d="M4 10v4h3l5 4V6L7 10z"/><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11"/>' },
  { color: '#D6E7DC', opac: 1, nombre: 'Sesión', icono: '<rect x="3" y="6" width="13" height="12" rx="3"/><path d="M16 10l5-3v10l-5-3"/>' },
];
const formas = [
  'M40 8C58 6 72 20 72 38S60 72 40 72 6 58 8 40 22 10 40 8z',
  'M42 6C62 10 74 26 70 44S52 74 34 70 4 52 10 32 24 4 42 6z',
  'M38 10C56 4 74 18 72 40S56 74 38 72 6 56 8 36 20 14 38 10z',
];
---
<div class="ds-iconos">
  {manchas.map((m, i) => (
    <figure class="ds-icono">
      <svg viewBox="0 0 80 80" width="110" height="110" aria-hidden="true">
        <path d={formas[0]} fill={m.color} opacity={m.opac}>
          <animate attributeName="d" dur={`${9 + i * 2}s`} repeatCount="indefinite" values={`${formas[0]};${formas[1]};${formas[2]};${formas[0]}`} calcMode="spline" keyTimes="0;.33;.66;1" keySplines=".45 0 .55 1;.45 0 .55 1;.45 0 .55 1" />
        </path>
        <g transform="translate(22 22) scale(1.5)" fill="none" stroke="#F5F3EB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={m.icono} />
      </svg>
      <figcaption>{m.nombre}</figcaption>
    </figure>
  ))}
</div>
