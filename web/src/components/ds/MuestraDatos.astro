---
/* Gráfico de ejemplo: una sola serie, un solo color, etiquetas directas, sin leyenda. */
const datos = [
  { k: '100 pacientes', v: 1.6 },
  { k: '500 pacientes', v: 8.0 },
  { k: '1.000 pacientes', v: 16.0 },
];
const max = 18;
---
<figure class="ds-datos">
  <svg viewBox="0 0 520 260" role="img" aria-label="Gráfico de ejemplo: ingresos ilustrativos según la cantidad de pacientes">
    {[0, 6, 12, 18].map((g) => {
      const y = 220 - (g / max) * 180;
      return <><line x1="70" x2="500" y1={y} y2={y} stroke="#1E4033" stroke-opacity=".1" /><text x="60" y={y + 4} text-anchor="end" font-size="11" fill="#8A958F" font-family="Manrope Variable, sans-serif">{g}</text></>;
    })}
    {datos.map((d, i) => {
      const h = (d.v / max) * 180;
      const x = 110 + i * 135;
      return (
        <g>
          <rect class="ds-barra" x={x} y={220 - h} width="80" height={h} rx="6" fill="#2F6B51" style={`--d:${i * 0.15}s`} />
          <text x={x + 40} y={212 - h} text-anchor="middle" font-size="14" font-weight="800" fill="#1E4033" font-family="Manrope Variable, sans-serif">{d.v.toFixed(1).replace('.', ',')} M</text>
          <text x={x + 40} y="242" text-anchor="middle" font-size="12" fill="#5D6A63" font-family="Manrope Variable, sans-serif">{d.k}</text>
        </g>
      );
    })}
  </svg>
  <figcaption>Ejemplo con datos ilustrativos del investor deck (millones de ARS por mes).</figcaption>
</figure>
