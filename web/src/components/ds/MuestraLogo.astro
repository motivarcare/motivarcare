---
import Logo from '../Logo.astro';
---
<div class="ds-logos">
  <figure class="ds-logo claro">
    <div class="ds-logo-lienzo"><Logo tam={96} /></div>
    <figcaption>Símbolo · degradé oscuro sobre crema</figcaption>
  </figure>
  <figure class="ds-logo oscuro">
    <div class="ds-logo-lienzo"><Logo tam={96} claro /></div>
    <figcaption>Símbolo · degradé claro sobre bosque</figcaption>
  </figure>
  <figure class="ds-logo claro ancho">
    <div class="ds-logo-lienzo"><span class="ds-firma"><Logo tam={44} /> MOTIVARCARE</span></div>
    <figcaption>Símbolo + palabra · Manrope 800, espaciado 0,16 em</figcaption>
  </figure>
  <figure class="ds-logo claro">
    <div class="ds-logo-lienzo">
      <svg viewBox="0 0 600 560" width="150" aria-hidden="true"><path d="M300 140 C 250 70, 150 50, 95 105 C 30 170, 45 280, 130 360 L 236 452 C 246 461, 250 470, 250 482 L 250 530 C 250 547, 266 556, 281 547 L 340 508 C 430 452, 565 350, 562 212 C 560 120, 490 60, 410 70 C 362 76, 326 104, 300 140 Z" fill="#D6E7DC" /></svg>
    </div>
    <figcaption>Mancha de corazón con cola, para fondos</figcaption>
  </figure>
</div>
