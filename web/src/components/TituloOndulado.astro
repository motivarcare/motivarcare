---
/* Título de la portada. La palabra entre *asteriscos* lleva el subrayado
   amarillo ondulante del investor deck (ej.: "en un solo *lugar*"). */
const { texto } = Astro.props as { texto: string };
const partes = texto.split(/\*([^*]+)\*/);
const ola1 = 'M3 12 C 30 3, 50 3, 70 10 S 110 18, 130 10 S 170 3, 197 9';
const ola2 = 'M3 9 C 30 15, 50 15, 70 10 S 110 4, 130 10 S 170 16, 197 11';
---
<h1 class="titulo-ondulado">
  {partes.map((p, i) =>
    i % 2 === 0 ? (
      p
    ) : (
      <em class="u">
        {p}
        <svg class="ola" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true">
          <path d={ola1}>
            <animate attributeName="d" dur="4.8s" repeatCount="indefinite" calcMode="spline" keyTimes="0;.5;1" keySplines=".45 0 .55 1;.45 0 .55 1" values={`${ola1};${ola2};${ola1}`} />
          </path>
        </svg>
      </em>
    )
  )}
</h1>

<style>
  .titulo-ondulado em { font-style: italic; font-weight: 400; color: var(--bosque-2); position: relative; white-space: nowrap; display: inline-block; isolation: isolate; }
  .ola { position: absolute; left: 0; bottom: -0.1em; width: 100%; height: 0.26em; overflow: visible; z-index: -1; }
  .ola path { fill: none; stroke: var(--amarillo); stroke-width: 5; stroke-linecap: round; vector-effect: non-scaling-stroke; }
</style>
