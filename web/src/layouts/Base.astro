---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Logo from '../components/Logo.astro';
import Estado from '../components/Estado.astro';

interface Props { titulo: string; descripcion?: string; frenteActual?: string }
const { titulo, descripcion = 'Portal interno de trabajo de MotivarCare', frenteActual } = Astro.props;
const frentes = (await getCollection('frentes')).sort((a, b) => a.id.localeCompare(b.id));
const ruta = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={descripcion} />
    <title>{titulo === 'Inicio' ? 'MotivarCare · Portal interno' : `${titulo} · MotivarCare`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="barra">
      <div class="contenedor">
        <a class="marca" href="/" aria-label="MotivarCare, ir al inicio del portal">
          <Logo tam={32} />
          <span>MOTIVARCARE <small>· Portal interno</small></span>
        </a>
        <button class="boton-menu" type="button" aria-expanded="false" aria-controls="menu" id="abrir-menu">
          <span class="hamburguesa" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Menú</span>
        </button>
      </div>
    </header>

    <div class="menu-fondo" id="menu-fondo" hidden></div>
    <nav class="menu" id="menu" aria-label="Secciones del portal" hidden>
      <div class="menu-cabeza">
        <p class="eyebrow">Secciones</p>
        <button class="cerrar-menu" type="button" id="cerrar-menu" aria-label="Cerrar menú">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
      </div>
      <ul>
        <li><a href="/" aria-current={ruta === '/' ? 'page' : undefined}><span class="num">00</span><span class="txt">Inicio</span></a></li>
        {frentes.map((f) => (
          <li>
            <a href={`/${f.id}/`} aria-current={frenteActual === f.id ? 'page' : undefined}>
              <span class="num">{f.data.numero}</span>
              <span class="txt">{f.data.titulo}</span>
              <Estado estado={f.data.estado} />
            </a>
          </li>
        ))}
      </ul>
      <a class="menu-extra" href="/contexto/">Contexto del proyecto →</a>
    </nav>

    <main>
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor">
        <span class="linea">Contenido generado a partir de los .md del repositorio</span>
        <a href="https://github.com/motivarcare/motivarcare">github.com/motivarcare/motivarcare</a>
      </div>
    </footer>

    <script>
      const boton = document.getElementById('abrir-menu')!;
      const menu = document.getElementById('menu')!;
      const fondo = document.getElementById('menu-fondo')!;
      const cerrarBtn = document.getElementById('cerrar-menu')!;
      const abrir = () => {
        menu.hidden = false;
        fondo.hidden = false;
        requestAnimationFrame(() => document.body.classList.add('menu-abierto'));
        boton.setAttribute('aria-expanded', 'true');
        (menu.querySelector('a[aria-current="page"]') as HTMLElement | null ?? menu.querySelector('a') as HTMLElement)?.focus();
      };
      const cerrar = () => {
        document.body.classList.remove('menu-abierto');
        boton.setAttribute('aria-expanded', 'false');
        setTimeout(() => { menu.hidden = true; fondo.hidden = true; }, 220);
        boton.focus();
      };
      boton.addEventListener('click', () => (menu.hidden ? abrir() : cerrar()));
      cerrarBtn.addEventListener('click', cerrar);
      fondo.addEventListener('click', cerrar);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) cerrar(); });
    </script>
  </body>
</html>
